{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "Consumers": {
    "Redeem": {
      "EntityPath": "redeem-requests",
      "MaxConcurrentCalls": 16,
      "MaxAutoLockRenewalDuration": "00:02:00",
      "UnknownMessagePolicy": "DeadLetter"
    },
    "Ledger": {
      "EntityPath": "offer-events",
      "Subscription": "ledger",
      "MaxConcurrentCalls": 1,
      "UnknownMessagePolicy": "Complete"
    },
    "Notification": {
      "EntityPath": "offer-events",
      "Subscription": "notification",
      "MaxConcurrentCalls": 4,
      "UnknownMessagePolicy": "Complete"
    }
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "LeaseDuration": "00:00:30",
    "BatchSize": 50,
    "MaxAttempts": 5,
    "Destinations": ["redeem-requests", "offer-events"]
  }
}
